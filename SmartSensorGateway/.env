# Docker-internal service values (waar services INTERN op luisteren)
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_WS_PORT=9001
NODERED_PORT=1880
INFLUXDB_HOST=influxdb
INFLUXDB_PORT=8086
PORTAINER_PORT=9000
PORTAINER_SSL_PORT=9443

# Host-side exposed ports 
MQTT_HOST_PORT=1883
MQTT_WS_HOST_PORT=9001
NODERED_HOST_PORT=1880
INFLUXDB_HOST_PORT=8086
PORTAINER_HOST_PORT=9000
PORTAINER_SSL_HOST_PORT=9443

# InfluxDB setup
INFLUXDB_USERNAME=edge
INFLUXDB_PASSWORD=123EdgeOps!
INFLUXDB_ORG=edge
INFLUXDB_BUCKET=senso
INFLUXDB_TOKEN=token

# MQTT topics
TOPIC_JOYSTICK=sensors/joy
TOPIC_BUTTONS=sensors/btn

# Portainer admin
PORTAINER_PASS=EdgePortainer!2026
